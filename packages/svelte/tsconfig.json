{
  "extends": [
    "@aws-amplify/typescript-config/tsconfig.svelte.json",
    "$app/tsconfig"
  ],
  "compilerOptions": {
    "baseUrl": null,
    "types": ["$app/types", "svelte", "node", "vite/client"]
  },
  "include": [
    "__mocks__",
    "__tests__",
    "src/lib/**/*.ts",
    "src/lib/**/*.svelte"
  ],
  "exclude": ["node_modules", ".svelte-kit"]
}
